# Copia a .env.production y rellena con valores reales.
# NUNCA subas .env.production a Git.

# Genera con: openssl rand -base64 64
JWT_SECRET=

# Genera con: openssl rand -base64 32
DB_PASSWORD=

# Tu dominio público (sin barra final)
DOMAIN=https://dojo.tudominio.com

# Orígenes permitidos por CORS (separados por coma, sin espacios)
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000

# URL de la API (local con Docker: puerto 8080; con nginx+dominio: https://tu-dominio.com)
NEXT_PUBLIC_API_URL=http://localhost:8080
